# The file the Keel Core image ships (step 7b, 2026-10-01): eth0, and an
# allow-hotplug eth1 placeholder for a second card.
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
    hostname core

iface eth0 inet6 dhcp
    hostname core

allow-hotplug eth1
iface eth1 inet dhcp
    hostname core

iface eth1 inet6 dhcp
    hostname core
