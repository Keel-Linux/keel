__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
debian/.debhelper/
debian/files
debian/keel/
debian/*.debhelper.log
debian/*.substvars
.coverage
.coverage*

# Public test certificates, committed on purpose and without their keys
# (tests/fixtures/certificates/README.md); a global *.pem rule would
# otherwise leave the tls.acme tests without their fixtures.
!tests/fixtures/certificates/*.pem
!tests/fixtures/inspect/turnkey/etc/ssl/private/cert.pem
# A fixture that stands for the Keel Cloud key's file: inspect only asks
# whether it is there, and a global *_key rule would leave it out
!tests/fixtures/inspect/keelcore/etc/keel/secrets/cloud_api_key
