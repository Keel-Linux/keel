# Load the firewall keel derived from the appliance manifests, at boot.
#
# keel spec apply --system writes /etc/keel/firewall/keel-manifest.nft in
# every installation mode (handbook decision 0097), enforce or report,
# and loads it then; an image build writes it with --root and does not
# load it. This unit loads it at every boot, before the network comes
# up, so the table survives a reboot, and a new node whose image wrote
# the file in enforce (the image declares `firewall.state: enforce`) is
# closed from its first packet; a file in report drops nothing. The file replaces keel's own table `inet keel` in
# one transaction and touches no other rule. Before the load, keel
# firewall repair writes an empty, cut or missing file of a node in
# enforce again (or loads a closed fallback and fails the unit). The
# unit runs with or without a spec: the program decides from evidence
# (file, record, copy, table), and is silent where there is none.
#
# A file nft refuses fails the unit: the node comes up without keel's
# table, and is degraded, which is visible. A table lost later comes
# back by keel's drop-in for nftables.service and by
# keel-firewall-watch.timer (keel firewall check --restore), whatever
# the spec says. The package never starts or restarts it on an upgrade
# (debian/rules, --no-start; decision 0073): the next apply loads it.
#
# After nftables.service, whose /etc/nftables.conf flushes the whole
# ruleset where an administrator enabled it.
[Unit]
Description=Load the firewall keel derived from the appliance manifests
DefaultDependencies=no
RequiresMountsFor=/etc/keel /var/lib/keel
After=local-fs.target nftables.service
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# an empty, cut or missing file of a node in enforce is written again by
# the apply's firewall step, else a closed fallback is loaded and the
# unit fails (keel firewall repair, decision 0097); nothing when the
# file is sound or the spec says off
ExecStartPre=/usr/bin/keel firewall repair --boot
ExecStart=/bin/sh -c '[ ! -e /etc/keel/firewall/keel-manifest.nft ] || exec /usr/sbin/nft -f /etc/keel/firewall/keel-manifest.nft'
# an empty or cut file loads nothing and nft succeeds: fail unless the
# table is loaded with the file's policy (firewall/firewall-loaded)
ExecStartPost=/usr/lib/keel/firewall-loaded

[Install]
WantedBy=multi-user.target
