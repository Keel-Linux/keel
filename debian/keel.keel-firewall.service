# Load the firewall keel derived from the appliance manifests, at boot.
#
# keel spec apply --system writes /etc/keel/firewall/keel-manifest.nft in
# every installation mode (handbook decision 0097), enforce or report,
# and loads it then; an image build writes it with --root and does not
# load it. This unit loads it at every boot, before the network comes
# up, so a new node is closed from its first packet and the table
# survives a reboot. The file replaces keel's own table `inet keel` in
# one transaction and touches no other rule. Without the file (a node
# where no apply ran since the upgrade, or `firewall.state: off`),
# systemd skips the unit.
#
# A file nft refuses fails the unit: the node comes up without keel's
# table, and is degraded, which is visible. A table lost later comes
# back by keel's drop-in for nftables.service and by
# keel-firewall-watch.timer (keel firewall check --restore), whatever
# the spec says. The package never starts or restarts it on an upgrade
# (debian/rules, --no-start; decision 0073): the next apply loads it.
#
# After nftables.service, whose /etc/nftables.conf flushes the whole
# ruleset where an administrator enabled it.
[Unit]
Description=Load the firewall keel derived from the appliance manifests
DefaultDependencies=no
RequiresMountsFor=/etc/keel
After=local-fs.target nftables.service
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/etc/keel/firewall/keel-manifest.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/keel/firewall/keel-manifest.nft

[Install]
WantedBy=multi-user.target
