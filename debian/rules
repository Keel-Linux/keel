#! /usr/bin/make -f

export PYTHONDONTWRITEBYTECODE=1

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_installsystemd:
	dh_installsystemd --name=keel-network-revert --no-start
	dh_installsystemd --name=keel-firewall --no-start
	dh_installsystemd --name=keel-mesh-members
	dh_installsystemd --name=keel-mesh-sync
	dh_installsystemd --name=keel-mesh-etcd
