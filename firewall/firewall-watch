#!/bin/sh
# What keel-firewall-watch.timer runs every 30 s (handbook decision 0097).
#
# The cheap path: when the table keel's file loaded is still the one the
# last good check saw (the sha256 of `nft -s list table inet keel`) and
# the file is the same file (inode, size, mtime, ctime), there is nothing to do,
# and no Python starts. On any difference, or with no mark, keel firewall
# check --restore checks everything, loads a lost table again from a
# sound file and writes the mark again (keel/system/fwwatch.py). With no
# file of keel's, nothing runs.
set -u
file=${KEEL_FIREWALL_FILE:-/etc/keel/firewall/keel-manifest.nft}
mark=${KEEL_FIREWALL_MARK:-/run/keel/firewall-watch.ok}
keel=${KEEL_BIN:-/usr/bin/keel}
nft=${KEEL_NFT:-/usr/sbin/nft}
spec=${KEEL_SPEC_FILE:-/etc/keel/instance.yaml}
record=${KEEL_FIREWALL_RECORD:-/var/lib/keel/firewall/state}

if [ ! -e "$file" ]; then
    # no file: nothing to watch where there is no spec, or where keel's
    # record says off; else keel says it, and writes the file again
    # (keel firewall repair)
    [ -e "$spec" ] || exit 0
    # off from keel's own record, never from text in the spec (a comment
    # that said `state: off` silenced the watch: the fifth real test)
    [ "$(cat "$record" 2>/dev/null)" = off ] && exit 0
    # no evidence that this node had a firewall (no record of keel's, no
    # table loaded): NOT APPLIED, a state, not a failure (0073, 0097): a
    # node upgraded from 0.23.97, or a new node before its first apply
    if [ ! -e "$record" ] && ! "$nft" list table inet keel >/dev/null 2>&1; then
        exit 0
    fi
    exec "$keel" firewall check --restore
fi
if [ -r "$mark" ]; then
    listed=$("$nft" -s list table inet keel 2>/dev/null) && {
        now="$(printf '%s\n' "$listed" | sha256sum | cut -d' ' -f1)"
        now="$now $(stat -c '%i %s %Y %Z' "$file")"
        [ "$now" = "$(cat "$mark")" ] && exit 0
    }
fi
exec "$keel" firewall check --restore
