#!/bin/sh
# keel-firewall.service's ExecStartPost (handbook decision 0097): the
# unit fails, and the node is degraded, unless the table inet keel is
# loaded with the policy keel's file says. `nft -f` of an empty or cut
# file loads nothing and succeeds; without this check the unit said
# success while the node was open (the second real test of keel pull
# request 307). A file with no policy line, or with no end, is cut.
set -u
file=${KEEL_FIREWALL_FILE:-/etc/keel/firewall/keel-manifest.nft}
nft=${KEEL_NFT:-/usr/sbin/nft}

policy=$(sed -n 's/.*hook input priority filter; policy \(drop\|accept\);.*/\1/p' "$file")
if [ -z "$policy" ] || [ "$(tail -n 1 "$file")" != "}" ]; then
    echo "keel-firewall: $file is empty or cut short; keel spec apply --system writes it again" >&2
    exit 1
fi
if ! "$nft" list table inet keel 2>/dev/null | grep -q "policy $policy;"; then
    echo "keel-firewall: table inet keel is not loaded with policy $policy, as $file says" >&2
    exit 1
fi
